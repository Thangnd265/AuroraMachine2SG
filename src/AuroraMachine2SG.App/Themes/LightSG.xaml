<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:AuroraMachine2SG.App.Themes">

    <!-- Converters -->
    <themes:BoolToVisibilityExConverter x:Key="ConvBoolToVis"/>
    <themes:BoolToVisibilityExConverter x:Key="ConvInvBoolToVis" Invert="True"/>
    <themes:InverseBoolConverter x:Key="ConvInverseBool"/>
    <themes:StringEqualsToVisibilityConverter x:Key="ConvStrEqVis"/>
    <themes:StringEqualsToBoolConverter x:Key="ConvStrEqBool"/>
    <themes:HiveStateToBrushConverter x:Key="ConvHiveBrush"/>
    <themes:UsedSlotToBrushConverter x:Key="ConvUsedBrush"/>
    <themes:ProductPresentToBrushConverter x:Key="ConvProductBrush"/>
    <themes:ActivePillBrushConverter x:Key="ConvActivePillBrush"/>
    <themes:JudgeToBrushConverter x:Key="ConvJudgeBrush"/>

    <!-- Exact Aurora 2.x LightSG & Brush.xaml Palette -->
    <Color x:Key="Aurora.Colors.Title.Background">#102236</Color>
    <Color x:Key="Aurora.Colors.Title.Component.Background">#37404E</Color>
    <Color x:Key="Aurora.Colors.GroupBox20">#ECECEF</Color>
    <Color x:Key="Aurora.Colors.GroupBox21">#E0E7FF</Color>
    <Color x:Key="Aurora.Colors.GroupBox22">#F0F0F0</Color>
    <Color x:Key="Aurora.Colors.GroupBox23">#E0E4E9</Color>
    <Color x:Key="Aurora.Colors.GroupBox24">#DDEBF1</Color>
    <Color x:Key="Aurora.Colors.GroupBox.Shadow">#DFDFDF</Color>
    <Color x:Key="Aurora.Colors.Header.Background">#D0D5E0</Color>

    <SolidColorBrush x:Key="Aurora.Brushes.Title.Background" Color="#102236"/>
    <SolidColorBrush x:Key="Aurora.Brushes.Title.Component.Background" Color="#37404E"/>
    <SolidColorBrush x:Key="Aurora.Brushes.GroupBox.GroupBox20" Color="#ECECEF"/>
    <SolidColorBrush x:Key="Aurora.Brushes.GroupBox.GroupBox21" Color="#E0E7FF"/>
    <SolidColorBrush x:Key="Aurora.Brushes.GroupBox.GroupBox22" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Aurora.Brushes.GroupBox.GroupBox23" Color="#E0E4E9"/>
    <SolidColorBrush x:Key="Aurora.Brushes.GroupBox.GroupBox24" Color="#DDEBF1"/>
    <SolidColorBrush x:Key="Aurora.Brushes.Header.Background" Color="#D0D5E0"/>
    <SolidColorBrush x:Key="Aurora.Brushes.Header.Border" Color="#888888"/>

    <SolidColorBrush x:Key="BLGRed" Color="#A50034"/>
    <SolidColorBrush x:Key="BNavy" Color="#1A2242"/>
    <SolidColorBrush x:Key="BSGLightGreen" Color="#A3DA97"/>
    <SolidColorBrush x:Key="BSGRed" Color="#C82506"/>
    <SolidColorBrush x:Key="BSGPastelBlue" Color="#B3CAFF"/>
    <SolidColorBrush x:Key="BSGLightYellow" Color="#FDFDBF"/>
    <SolidColorBrush x:Key="BSGLightGray" Color="#EAEAEB"/>

    <SolidColorBrush x:Key="BHiveRed" Color="#E15358"/>
    <SolidColorBrush x:Key="BHiveYellow" Color="#FFDA5A"/>
    <SolidColorBrush x:Key="BHiveGreen" Color="#8DD471"/>
    <SolidColorBrush x:Key="BHiveBlue" Color="#518FFF"/>
    <SolidColorBrush x:Key="BHiveGrey" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="BHivePurple" Color="#4233A6"/>

    <!-- Clean Vector Geometries (No Emoji Icons) -->
    <Geometry x:Key="GeoPlay">M 6,4 L 20,12 L 6,20 Z</Geometry>
    <Geometry x:Key="GeoPause">M 6,4 H 10 V 20 H 6 Z M 14,4 H 18 V 20 H 14 Z</Geometry>
    <Geometry x:Key="GeoStop">M 5,5 H 19 V 19 H 5 Z</Geometry>
    <Geometry x:Key="GeoFolder">M 3,6 H 9 L 11,8 H 21 V 19 H 3 Z</Geometry>
    <Geometry x:Key="GeoHome">M 12,3 L 3,10 H 6 V 20 H 10 V 14 H 14 V 20 H 18 V 10 H 21 Z</Geometry>
    <Geometry x:Key="GeoControl">M 4,6 H 20 V 8 H 4 Z M 4,11 H 20 V 13 H 4 Z M 4,16 H 20 V 18 H 4 Z M 8,4 H 11 V 10 H 8 Z M 14,9 H 17 V 15 H 14 Z M 7,14 H 10 V 20 H 7 Z</Geometry>
    <Geometry x:Key="GeoRecipe">M 6,3 H 15 L 19,7 V 21 H 6 Z M 9,10 H 16 V 12 H 9 Z M 9,14 H 16 V 16 H 9 Z</Geometry>
    <Geometry x:Key="GeoAlarm">M 12,3 L 22,20 H 2 Z M 11,9 V 14 H 13 V 9 Z M 11,16 V 18 H 13 V 16 Z</Geometry>
    <Geometry x:Key="GeoMonitor">M 3,19 H 21 V 21 H 3 Z M 5,13 H 8 V 18 H 5 Z M 10,8 H 13 V 18 H 10 Z M 15,5 H 18 V 18 H 15 Z</Geometry>
    <Geometry x:Key="GeoSetting">M 10,2 H 14 L 14.8,4.8 L 17.3,6.2 L 20,5.2 L 22,8.7 L 19.8,10.6 V 13.4 L 22,15.3 L 20,18.8 L 17.3,17.8 L 14.8,19.2 L 14,22 H 10 L 9.2,19.2 L 6.7,17.8 L 4,18.8 L 2,15.3 L 4.2,13.4 V 10.6 L 2,8.7 L 4,5.2 L 6.7,6.2 L 9.2,4.8 Z M 12,9 A 3,3 0 1 0 12,15 A 3,3 0 1 0 12,9 Z</Geometry>
    <Geometry x:Key="GeoLock">M 7,10 V 7 A 5,5 0 0 1 17,7 V 10 H 19 V 21 H 5 V 10 Z M 9,10 H 15 V 7 A 3,3 0 0 0 9,7 Z</Geometry>
    <Geometry x:Key="GeoBadge">M 4,4 H 20 V 20 H 4 Z M 8,8 A 2.5,2.5 0 1 0 8,13 A 2.5,2.5 0 1 0 8,8 Z M 13,9 H 18 V 11 H 13 Z M 6,16 C 6,14 10,14 10,16 V 17 H 6 Z M 13,13 H 18 V 15 H 13 Z</Geometry>

    <!-- Aurora 2.0 GroupBox Styles (StGroupBox20..24) -->
    <DataTemplate x:Key="GroupBoxHeaderTemplate">
        <ContentPresenter Content="{Binding}">
            <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#111827"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </ContentPresenter.Resources>
        </ContentPresenter>
    </DataTemplate>

    <Style x:Key="StGroupBox21" TargetType="GroupBox">
        <Setter Property="HeaderTemplate" Value="{StaticResource GroupBoxHeaderTemplate}"/>
        <Setter Property="Background" Value="{StaticResource Aurora.Brushes.GroupBox.GroupBox21}"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.18" Color="#64748B"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="HeaderHost" Padding="10,5,10,3" BorderBrush="#15000000" BorderThickness="0,0,0,1">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StGroupBox20" TargetType="GroupBox" BasedOn="{StaticResource StGroupBox21}">
        <Setter Property="Background" Value="{StaticResource Aurora.Brushes.GroupBox.GroupBox20}"/>
    </Style>
    <Style x:Key="StGroupBox22" TargetType="GroupBox" BasedOn="{StaticResource StGroupBox21}">
        <Setter Property="Background" Value="{StaticResource Aurora.Brushes.GroupBox.GroupBox22}"/>
    </Style>
    <Style x:Key="StGroupBox23" TargetType="GroupBox" BasedOn="{StaticResource StGroupBox21}">
        <Setter Property="Background" Value="{StaticResource Aurora.Brushes.GroupBox.GroupBox23}"/>
    </Style>
    <Style x:Key="StGroupBox24" TargetType="GroupBox" BasedOn="{StaticResource StGroupBox21}">
        <Setter Property="Background" Value="{StaticResource Aurora.Brushes.GroupBox.GroupBox24}"/>
    </Style>

    <!-- Rounded & Action Buttons -->
    <Style x:Key="StRoundedButton" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- HIVE Top Indicator ToggleButtons (56x56) -->
    <Style x:Key="StToggleStatus" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mode Toggle / Radio Styles (StToggle1 & StToggle2) -->
    <Style x:Key="StToggle1" TargetType="ToggleButton">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="BorderBrush" Value="#94A3B8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="6,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#A3DA97"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2E7D32"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StModeRadio" TargetType="RadioButton">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="BorderBrush" Value="#94A3B8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="6,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#518FFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1D4ED8"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left Sidebar Main Navigation Button -->
    <Style x:Key="StLeftMenuButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#CBD5E1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="4,0,0,0" BorderBrush="Transparent" Padding="6,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#243B55"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#A3DA97"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
</ResourceDictionary>
