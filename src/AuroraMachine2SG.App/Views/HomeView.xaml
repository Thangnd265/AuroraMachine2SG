<UserControl x:Class="AuroraMachine2SG.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuroraMachine2SG.App.Controls"
             Background="#FBFBFB" FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="10,8,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2.35*"/>
            <RowDefinition Height="1.05*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.15*"/>
        </Grid.ColumnDefinitions>

        <!-- TOP-LEFT: Alarm Banner + MultiSequence Station Map (Exact UCHomeView.xaml ColSpan=2) -->
        <GroupBox Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource StGroupBox22}" Background="#FFFFFF" Padding="10,8,10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Alarm Status Boxes + EMO TEST + Ready -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Height="52">
                    <controls:BorderMonitor Width="125" Margin="0,0,6,0" Padding="8,4" IsNormal="{Binding Runtime.NoAlarm}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Code" FontSize="11" Foreground="#475569"/>
                            <TextBlock Text="{Binding Runtime.ActiveAlarmCode}" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </controls:BorderMonitor>
                    <controls:BorderMonitor Width="125" Margin="4,0" Padding="8,4" IsNormal="{Binding Runtime.NoAlarm}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Category" FontSize="11" Foreground="#475569"/>
                            <TextBlock Text="{Binding Runtime.ActiveAlarmCategory}" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </controls:BorderMonitor>
                    <controls:BorderMonitor Width="125" Margin="4,0" Padding="8,4" IsNormal="{Binding Runtime.NoAlarm}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ALARM TIME" FontSize="11" Foreground="#475569"/>
                            <TextBlock Text="{Binding Runtime.ActiveAlarmTime}" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </controls:BorderMonitor>
                    <controls:BorderMonitor Width="115" Margin="4,0" Padding="8,4" IsNormal="True">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Material" FontSize="11" Foreground="#475569"/>
                            <TextBlock Text="OK (FULL)" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </controls:BorderMonitor>
                    <Border Background="#FFF0F0" CornerRadius="5" Margin="14,0,0,0" Padding="8,4" BorderBrush="#FFD0D0" BorderThickness="1">
                        <ToggleButton Content="EMO TEST" Width="96" Height="38"
                                      IsChecked="{Binding Runtime.IsEmoTest, Mode=TwoWay}"
                                      Style="{StaticResource StToggle1}" Foreground="#B91C1C"/>
                    </Border>
                </StackPanel>

                <ToggleButton Grid.Column="1" Content="Ready" Width="130" Height="46" FontSize="14"
                              IsChecked="{Binding Runtime.IsMachineReady, Mode=TwoWay}"
                              Style="{StaticResource StToggle1}"/>

                <!-- MultiSequence Station Flow Grid -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="6,10,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.7*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.85*"/>
                        <RowDefinition Height="0.85*"/>
                        <RowDefinition Height="1.05*"/>
                    </Grid.RowDefinitions>

                    <!-- MPS Branch (Row 0, Col 1 & 2) -->
                    <GroupBox Grid.Row="0" Grid.Column="1" Header="MPSLoading" Style="{StaticResource StGroupBox21}">
                        <Border Background="{Binding Runtime.MpsSlots[0].HasProduct, Converter={StaticResource ConvProductBrush}}"
                                CornerRadius="5" BorderBrush="#94A3B8" BorderThickness="1" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Runtime.MpsSlots[0].SerialNo}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding Runtime.MpsSlots[0].StepText}" Foreground="#334155" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </GroupBox>
                    <GroupBox Grid.Row="0" Grid.Column="2" Header="MPSProcess" Style="{StaticResource StGroupBox21}">
                        <Border Background="{Binding Runtime.MpsSlots[1].HasProduct, Converter={StaticResource ConvProductBrush}}"
                                CornerRadius="5" BorderBrush="#94A3B8" BorderThickness="1" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Runtime.MpsSlots[1].SerialNo}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding Runtime.MpsSlots[1].StepText}" Foreground="#334155" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </GroupBox>

                    <!-- Process Center (Row 1, Col 2) -->
                    <GroupBox Grid.Row="1" Grid.Column="2" Header="Process (Gantry Screw)" Style="{StaticResource StGroupBox24}">
                        <Border Background="{Binding Runtime.HsgSlots[2].HasProduct, Converter={StaticResource ConvProductBrush}}"
                                CornerRadius="5" BorderBrush="#64748B" BorderThickness="1" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Runtime.HsgSlots[2].SerialNo}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding Runtime.HsgSlots[2].StepText}" Foreground="#0F172A" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </GroupBox>

                    <!-- MultiSequence StationMonitors Strip (Row 0..1, Col 3..5) with Right-Click Remove Product -->
                    <GroupBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Grid.ColumnSpan="3"
                              Header="MultiSequence Station Monitors (Right-click to Remove Product)" Style="{StaticResource StGroupBox22}">
                        <ItemsControl ItemsSource="{Binding Runtime.StationMonitors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Position}" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <Border Grid.Row="1" CornerRadius="8" BorderBrush="#334155" BorderThickness="1"
                                                Background="{Binding HasProduct, Converter={StaticResource ConvProductBrush}}"
                                                Padding="4" Tag="{Binding}" MouseRightButtonUp="StationSlot_RightClick"
                                                ToolTip="Right-click to Remove Product (Tossing)">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Background="#111827" CornerRadius="3" Padding="4,1"
                                                        Visibility="{Binding HasProduct, Converter={StaticResource ConvBoolToVis}}">
                                                    <TextBlock Foreground="White" Text="{Binding No, StringFormat={}{0:00000}}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding SerialNo}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <!-- Bottom Main Conveyor Line (Row 2, Col 0..5) -->
                    <GroupBox Grid.Row="2" Grid.Column="0" Header="Hermes Input" Style="{StaticResource StGroupBox20}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Upstream TCP" FontSize="10.5" Foreground="#475569"/>
                            <TextBlock Text="READY (9852)" FontWeight="Bold" Foreground="#15803D"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Grid.Column="1" Header="Loading" Style="{StaticResource StGroupBox23}">
                        <Border Background="{Binding Runtime.HsgSlots[0].HasProduct, Converter={StaticResource ConvProductBrush}}"
                                CornerRadius="5" BorderBrush="#94A3B8" BorderThickness="1" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Runtime.HsgSlots[0].SerialNo}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding Runtime.HsgSlots[0].WipCode}" Foreground="#475569" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Grid.Column="2" Header="Align" Style="{StaticResource StGroupBox23}">
                        <Border Background="{Binding Runtime.HsgSlots[1].HasProduct, Converter={StaticResource ConvProductBrush}}"
                                CornerRadius="5" BorderBrush="#94A3B8" BorderThickness="1" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Runtime.HsgSlots[1].SerialNo}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding Runtime.HsgSlots[1].StepText}" Foreground="#475569" FontSize="10.5"/>
                            </StackPanel>
                        </Border>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Grid.Column="3" Header="Inspection" Style="{StaticResource StGroupBox23}">
                        <Border Background="{Binding Runtime.HsgSlots[3].HasProduct, Converter={StaticResource ConvProductBrush}}"
                                CornerRadius="5" BorderBrush="#94A3B8" BorderThickness="1" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Runtime.HsgSlots[3].SerialNo}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding Runtime.HsgSlots[3].StepText}" Foreground="#475569" FontSize="10.5"/>
                            </StackPanel>
                        </Border>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Grid.Column="4" Header="Unloading" Style="{StaticResource StGroupBox23}">
                        <Border Background="{Binding Runtime.HsgSlots[4].HasProduct, Converter={StaticResource ConvProductBrush}}"
                                CornerRadius="5" BorderBrush="#94A3B8" BorderThickness="1" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Runtime.HsgSlots[4].SerialNo}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding Runtime.HsgSlots[4].StepText}" Foreground="#475569" FontSize="10.5"/>
                            </StackPanel>
                        </Border>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Grid.Column="5" Header="Hermes Output" Style="{StaticResource StGroupBox20}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Downstream" FontSize="10.5" Foreground="#475569"/>
                            <TextBlock Text="AVAILABLE" FontWeight="Bold" Foreground="#15803D"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <!-- Bottom-Right Subsystem LEDs -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,6,0">
                    <TextBlock Text="PDCA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Width="11" Height="11" Fill="{StaticResource BSGLightGreen}" Margin="5,0,14,0"/>
                    <TextBlock Text="Hermes" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Width="11" Height="11" Fill="{Binding Runtime.UseHermes, Converter={StaticResource ConvActivePillBrush}}" Margin="5,0,14,0"/>
                    <TextBlock Text="Vision" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse Width="11" Height="11" Fill="{StaticResource BSGLightGreen}" Margin="5,0,4,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- TOP-RIGHT: Door Lock/Open, Mode Matrix, CycleTime/UPH/UPD, Pie Ratio Chart -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.35*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Style="{StaticResource StGroupBox21}" Background="GhostWhite">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="2">
                        <Button Content="{Binding Runtime.Loc[DoorOpen]}" Height="44" Margin="3,2"
                                Style="{StaticResource StRoundedButton}"
                                IsEnabled="{Binding Runtime.IsSequenceRunning, Converter={StaticResource ConvInverseBool}}"
                                Click="DoorOpen_Click"/>
                        <Button Content="{Binding Runtime.Loc[DoorLock]}" Height="44" Margin="3,2"
                                Style="{StaticResource StRoundedButton}"
                                Background="{Binding Runtime.IsDoorLocked, Converter={StaticResource ConvActivePillBrush}}"
                                IsEnabled="{Binding Runtime.IsSequenceRunning, Converter={StaticResource ConvInverseBool}}"
                                Click="DoorLock_Click"/>
                    </UniformGrid>

                    <Rectangle Grid.Row="1" Stroke="{StaticResource BSGPastelBlue}" StrokeThickness="1.5" StrokeDashArray="4 3" Margin="6,6" Height="2"/>

                    <UniformGrid Grid.Row="2" Columns="3" Rows="3">
                        <Button Content="{Binding Runtime.Loc[ManualLoad]}" Style="{StaticResource StRoundedButton}" Padding="4,4" FontSize="11.5" Margin="3" Click="ManualLoad_Click"/>
                        <Button Content="{Binding Runtime.Loc[ManualUnload]}" Style="{StaticResource StRoundedButton}" Padding="4,4" FontSize="11.5" Margin="3" Click="ManualUnload_Click"/>
                        <ToggleButton Content="HERMES" Style="{StaticResource StToggle1}" Margin="3"
                                      IsChecked="{Binding Runtime.UseHermes, Mode=TwoWay}" IsEnabled="{Binding Runtime.IsSequenceIdle}"/>

                        <RadioButton Content="CPK" GroupName="ModeGrp" Style="{StaticResource StModeRadio}" Margin="3"
                                     IsChecked="{Binding Runtime.CurrentMode, Converter={StaticResource ConvStrEqBool}, ConverterParameter=CPK, Mode=OneWay}"
                                     IsEnabled="{Binding Runtime.IsSequenceIdle}" Tag="CPK" Click="ModeRadio_Click"/>
                        <RadioButton Content="PDCA" GroupName="ModeGrp" Style="{StaticResource StModeRadio}" Margin="3"
                                     IsChecked="{Binding Runtime.CurrentMode, Converter={StaticResource ConvStrEqBool}, ConverterParameter=PDCA_ONLINE, Mode=OneWay}"
                                     IsEnabled="{Binding Runtime.IsSequenceIdle}" Tag="PDCA_ONLINE" Click="ModeRadio_Click"/>
                        <RadioButton Content="PDCA OFF" GroupName="ModeGrp" Style="{StaticResource StModeRadio}" Margin="3"
                                     IsChecked="{Binding Runtime.CurrentMode, Converter={StaticResource ConvStrEqBool}, ConverterParameter=PDCA_OFFLINE, Mode=OneWay}"
                                     IsEnabled="{Binding Runtime.IsSequenceIdle}" Tag="PDCA_OFFLINE" Click="ModeRadio_Click"/>

                        <RadioButton Content="GRR" GroupName="ModeGrp" Style="{StaticResource StModeRadio}" Margin="3"
                                     IsChecked="{Binding Runtime.CurrentMode, Converter={StaticResource ConvStrEqBool}, ConverterParameter=GRR, Mode=OneWay}"
                                     IsEnabled="{Binding Runtime.IsSequenceIdle}" Tag="GRR" Click="ModeRadio_Click"/>
                        <RadioButton Content="DRY-RUN" GroupName="ModeGrp" Style="{StaticResource StModeRadio}" Margin="3"
                                     IsChecked="{Binding Runtime.CurrentMode, Converter={StaticResource ConvStrEqBool}, ConverterParameter=DRYRUN, Mode=OneWay}"
                                     IsEnabled="{Binding Runtime.IsSequenceIdle}" Tag="DRYRUN" Click="ModeRadio_Click"/>
                        <ToggleButton Content="MPS Use" Style="{StaticResource StToggle1}" Margin="3"
                                      IsChecked="{Binding Runtime.UseMps, Mode=TwoWay}"
                                      IsEnabled="{Binding Runtime.IsSequenceRunning, Converter={StaticResource ConvInverseBool}}"/>
                    </UniformGrid>
                </Grid>
            </GroupBox>

            <!-- Cycle Time / UPH / UPD -->
            <UniformGrid Grid.Row="1" Columns="3">
                <GroupBox Style="{StaticResource StGroupBox22}" Background="GhostWhite" Header="{Binding Runtime.Loc[CycleTime]}" Padding="6,2">
                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding Runtime.CycleTime, StringFormat={}{0:F2}s}"/>
                </GroupBox>
                <GroupBox Style="{StaticResource StGroupBox22}" Background="GhostWhite" Header="UPH" Padding="6,2">
                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding Runtime.Uph}"/>
                </GroupBox>
                <GroupBox Style="{StaticResource StGroupBox22}" Background="GhostWhite" Header="UPD" Padding="6,2">
                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding Runtime.Upd}"/>
                </GroupBox>
            </UniformGrid>

            <!-- Yield Pie Chart -->
            <GroupBox Grid.Row="2" Style="{StaticResource StGroupBox21}" Background="GhostWhite" Padding="6,2">
                <controls:PieRatioChartView PassCount="{Binding Runtime.PassCount}" NgCount="{Binding Runtime.NgCount}"/>
            </GroupBox>
        </Grid>

        <!-- BOTTOM ROW (4 panels matching UCHomeView.xaml): Screw Curve | Cassette & Tray | Latest History | Daily & Weekly UPH/UPD -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.75*"/>
                <ColumnDefinition Width="0.52*"/>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="1.10*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Screw Torque-Angle Curve -->
            <GroupBox Grid.Column="0" Style="{StaticResource StGroupBox22}" Background="White" Header="Gantry Screw Torque Monitor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,4">
                        <TextBlock Text="{Binding Runtime.LastScrewId}" Foreground="DarkBlue" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Runtime.LastWipCode}" HorizontalAlignment="Right" Foreground="#475569"/>
                    </DockPanel>
                    <controls:TorqueCurveView Grid.Row="1" Curve="{Binding Runtime.LastScrewCurve}" NgLimit="3.8"/>
                </Grid>
            </GroupBox>

            <!-- 2. Cassette & Tray Matrix -->
            <GroupBox Grid.Column="1" Style="{StaticResource StGroupBox22}" Header="Tray UI Sample">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Aurora.Brushes.GroupBox.GroupBox21}" CornerRadius="4" Padding="4" Margin="0,0,3,0">
                        <ItemsControl ItemsSource="{Binding Runtime.CassetteCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="10"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray" BorderThickness="0.6" Margin="2,1" Background="{Binding Used, Converter={StaticResource ConvUsedBrush}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Aurora.Brushes.GroupBox.GroupBox21}" CornerRadius="4" Padding="4" Margin="3,0,0,0">
                        <ItemsControl ItemsSource="{Binding Runtime.TrayCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray" BorderThickness="0.6" Margin="2" Background="{Binding Used, Converter={StaticResource ConvUsedBrush}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cassette" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,3,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Tray" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,3,0,0"/>
                </Grid>
            </GroupBox>

            <!-- 3. Latest History -->
            <GroupBox Grid.Column="2" Style="{StaticResource StGroupBox22}" Header="{Binding Runtime.Loc[LatestHistory]}">
                <DataGrid ItemsSource="{Binding Runtime.LatestHistory}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="25">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="66"/>
                        <DataGridTextColumn Header="Serial No" Binding="{Binding SerialNo}" Width="*"/>
                        <DataGridTextColumn Header="CT(s)" Binding="{Binding CycleSec, StringFormat={}{0:F2}}" Width="50"/>
                        <DataGridTextColumn Header="Nm" Binding="{Binding PeakTorqueNm, StringFormat={}{0:F2}}" Width="46"/>
                        <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="52"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- 4. Daily / Weekly UPH/UPD Bar Chart -->
            <GroupBox Grid.Column="3" Style="{StaticResource StGroupBox22}" Header="UPH / UPD (Reset at 8 AM)">
                <TabControl>
                    <TabItem Header="Daily (24H)">
                        <controls:BarTrendChartView x:Name="DailyChart" IsWeekly="False"/>
                    </TabItem>
                    <TabItem Header="Weekly (7D)">
                        <controls:BarTrendChartView x:Name="WeeklyChart" IsWeekly="True"/>
                    </TabItem>
                </TabControl>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
