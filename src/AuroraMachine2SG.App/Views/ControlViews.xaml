<UserControl x:Class="AuroraMachine2SG.App.Views.ControlViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuroraMachine2SG.App.Controls"
             Background="#F8FAFC" FontSize="12">
    <Grid Margin="10">
        <!-- 1. Manual -->
        <Grid Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Manual'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Manual Cylinder / Vacuum / Conveyor Actuators" Style="{StaticResource StGroupBox21}">
                <ItemsControl ItemsSource="{Binding Runtime.IoBits}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Margin="4,3" Height="34" Style="{StaticResource StToggle1}"
                                          IsChecked="{Binding State, Mode=TwoWay}"
                                          IsEnabled="{Binding IsOutput}">
                                <TextBlock Text="{Binding Name}" FontSize="11.5"/>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Manual Station Transfer &amp; Step Control" Style="{StaticResource StGroupBox22}">
                <StackPanel Margin="10">
                    <TextBlock Text="Execute single-cycle station actions (only when Main Sequence is Stopped/Idle):" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="Manual Load HSG" Style="{StaticResource StRoundedButton}" Width="160" Height="40" Margin="4" Click="ManualLoad_Click"/>
                        <Button Content="Single Step Advance" Style="{StaticResource StRoundedButton}" Width="160" Height="40" Margin="4" Click="SingleStep_Click"/>
                        <Button Content="Manual Unload HSG" Style="{StaticResource StRoundedButton}" Width="160" Height="40" Margin="4" Click="ManualUnload_Click"/>
                        <Button Content="Open JOG Pendant" Style="{StaticResource StRoundedButton}" Width="160" Height="40" Margin="4" Click="OpenJog_Click"/>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Runtime.HsgSlots}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0" Height="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Station Slot" Binding="{Binding Position}" Width="120"/>
                            <DataGridCheckBoxColumn Header="Occupied" Binding="{Binding HasProduct}" Width="80"/>
                            <DataGridTextColumn Header="Serial No" Binding="{Binding SerialNo}" Width="*"/>
                            <DataGridTextColumn Header="State" Binding="{Binding StepText}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- 2. Calibration -->
        <GroupBox Header="Camera-to-Stage 9-Point UVW / XYTheta Calibration" Style="{StaticResource StGroupBox21}"
                  Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Calibration'}">
            <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Align Camera Fiducial Crosshair with WMX3 Stage Reference Grid (T31 Vision IF):" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                <UniformGrid Columns="3" Margin="0,0,0,14">
                    <GroupBox Header="Offset X (mm)" Style="{StaticResource StGroupBox22}">
                        <TextBox Text="{Binding ControlVM.CalibOffsetX}" FontSize="16" FontWeight="Bold" Padding="6"/>
                    </GroupBox>
                    <GroupBox Header="Offset Y (mm)" Style="{StaticResource StGroupBox22}">
                        <TextBox Text="{Binding ControlVM.CalibOffsetY}" FontSize="16" FontWeight="Bold" Padding="6"/>
                    </GroupBox>
                    <GroupBox Header="Theta (deg)" Style="{StaticResource StGroupBox22}">
                        <TextBox Text="{Binding ControlVM.CalibThetaDeg}" FontSize="16" FontWeight="Bold" Padding="6"/>
                    </GroupBox>
                </UniformGrid>
                <Button Content="Execute 9-Point Auto Calibration" Style="{StaticResource StRoundedButton}" Width="250" Height="40" HorizontalAlignment="Left" Click="RunCalib_Click"/>
                <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,14,0,0">
                    <TextBlock Text="{Binding ControlVM.CalibResult}" FontSize="13" FontWeight="Bold" Foreground="#15803D"/>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- 3. Device (With Interactive Simulation Test Bench & External Aurora Doc/Data Importer) -->
        <Grid Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Device'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Registered Aurora Devices (Select a Row to Open Simulation Test Bench)" Style="{StaticResource StGroupBox22}">
                <DataGrid ItemsSource="{Binding Runtime.Devices}" SelectedItem="{Binding ControlVM.SelectedDevice, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActivated, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
                        <DataGridCheckBoxColumn Header="Simul" Binding="{Binding IsSimul, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="155" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Endpoint / Port" Binding="{Binding EndpointOrPort}" Width="135"/>
                        <DataGridTextColumn Header="Live Status / Last RX" Binding="{Binding StatusMessage}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Interactive Device Simulation Test Bench" Style="{StaticResource StGroupBox21}">
                <StackPanel Margin="10">
                    <TextBlock Text="Target Device:" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ControlVM.SelectedDevice.DeviceId, FallbackValue='(None)'}" FontSize="16" FontWeight="ExtraBold" Foreground="#1E3A8A" Margin="0,2,0,10"/>

                    <TextBlock Text="Simulated Command (e.g. TRIGGER_READ, GRAB_T31, HEARTBEAT, RUN_SCREW):" FontWeight="SemiBold"/>
                    <ComboBox Text="{Binding ControlVM.DeviceTestCmd, Mode=TwoWay}" IsEditable="True" Height="30" Margin="0,4,0,10">
                        <ComboBoxItem Content="TRIGGER_READ"/>
                        <ComboBoxItem Content="GRAB_VISION_T31"/>
                        <ComboBoxItem Content="FASTEN_SCREW_SHOT"/>
                        <ComboBoxItem Content="HIVE_MACHINE_STATE"/>
                        <ComboBoxItem Content="HERMES_BOARD_AVAIL"/>
                    </ComboBox>

                    <TextBlock Text="Simulated Payload / Custom Barcode Override:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding ControlVM.DeviceCustomArg, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,4,0,10"/>

                    <CheckBox Content="Force Next Device Response to NG / Error (Test Sequence Alarm Path)"
                              IsChecked="{Binding ControlVM.DeviceForceNg, Mode=TwoWay}" FontWeight="Bold" Foreground="#B91C1C" Margin="0,0,0,12"/>

                    <Button Content="▶ Execute Simulated Device Command" Style="{StaticResource StRoundedButton}" Background="#8DD471" Height="38" Click="ExecDeviceTest_Click"/>

                    <Border Background="#0F172A" CornerRadius="5" Padding="10" Margin="0,12,0,14" MinHeight="74">
                        <TextBlock Text="{Binding ControlVM.LastDeviceResponse}" Foreground="#A7F3D0" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </Border>

                    <Separator Margin="0,4,0,10"/>
                    <TextBlock Text="Import Existing Aurora Project Configs (_config_setting / _config_recipe / _alarm):" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Button Content="Import From Aurora Doc\Data Folder..." Style="{StaticResource StRoundedButton}" Background="#E0E7FF" Height="36" Click="ImportAuroraData_Click"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- 4. Sequence (LIVE VISUAL FLOWCHART & NODE-BY-NODE STEP DEBUGGER) -->
        <Grid Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Sequence'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Registered Sequences in Active Equipment Profile -->
            <GroupBox Grid.Column="0" Header="Registered Sequences" Style="{StaticResource StGroupBox22}">
                <ListBox ItemsSource="{Binding Runtime.ActiveSequences}" SelectedItem="{Binding ControlVM.SelectedSequence, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,3">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SequenceId}" FontWeight="Bold" FontSize="13"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding CurrentNodeId, StringFormat=Active: {0}}" FontSize="11" Foreground="#15803D" FontWeight="SemiBold" Margin="20,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- Center: Interactive Flowchart Canvas + Execution Toolbar -->
            <GroupBox Grid.Column="1" Header="Live Sequence Flowchart Visualizer (Click any Node to Inspect / Breakpoint / Force Error)" Style="{StaticResource StGroupBox21}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="▶ Run All" Style="{StaticResource StRoundedButton}" Background="#8DD471" Width="95" Margin="2" Click="SeqStart_Click"/>
                        <Button Content="⏸ Pause" Style="{StaticResource StRoundedButton}" Background="#518FFF" Foreground="White" Width="85" Margin="2" Click="SeqPause_Click"/>
                        <Button Content="⏭ Step 1 Node" Style="{StaticResource StRoundedButton}" Background="#E0E7FF" Width="118" Margin="2" Click="SeqStepSelected_Click"/>
                        <Button Content="⏹ Cycle Stop" Style="{StaticResource StRoundedButton}" Background="#FFDA5A" Width="105" Margin="2" Click="SeqCycleStop_Click"/>
                        <Button Content="↺ Reset Seq" Style="{StaticResource StRoundedButton}" Width="96" Margin="2" Click="SeqReset_Click"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="Speed:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox Width="76" SelectedIndex="2" SelectionChanged="SimSpeed_Changed">
                                <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                <ComboBoxItem Content="1.0x" Tag="1.0"/>
                                <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                <ComboBoxItem Content="4.0x" Tag="4.0"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <controls:SequenceFlowchartView Sequence="{Binding ControlVM.SelectedSequence}"
                                                        SelectedNode="{Binding ControlVM.SelectedNode, Mode=TwoWay}"/>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <!-- Right: Selected Node Debugger & Event Injector -->
            <GroupBox Grid.Column="2" Header="Node Debugger &amp; Event Injector" Style="{StaticResource StGroupBox22}">
                <StackPanel Margin="8">
                    <TextBlock Text="Selected Flowchart Node:" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ControlVM.SelectedNode.Id, FallbackValue='(Click a node)'}" FontSize="15" FontWeight="ExtraBold" Foreground="#1E3A8A" Margin="0,2,0,4"/>
                    <TextBlock Text="{Binding ControlVM.SelectedNode.Kind, StringFormat=Node Kind : {0}}" Foreground="#475569"/>
                    <TextBlock Text="{Binding ControlVM.SelectedNode.State, StringFormat=Live State : {0}}" FontWeight="Bold" Margin="0,2"/>
                    <TextBlock Text="{Binding ControlVM.SelectedNode.HitCount, StringFormat=Execution Count : {0}}" Margin="0,2"/>
                    <TextBlock Text="{Binding ControlVM.SelectedNode.LastResult, StringFormat=Last Result : {0}}" Margin="0,2,0,10"/>

                    <CheckBox Content="● Breakpoint on Selected Node" IsChecked="{Binding ControlVM.SelectedNode.HasBreakpoint, Mode=TwoWay}" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4"/>
                    <CheckBox Content="⚡ Arm Force Error on Next Hit" IsChecked="{Binding ControlVM.SelectedNode.ForceErrorArmed, Mode=TwoWay}" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,10"/>
                    <Button Content="Resume From Breakpoint" Style="{StaticResource StRoundedButton}" Height="32" Margin="0,0,0,14" Click="ResumeBp_Click"/>

                    <Separator Margin="0,2,0,10"/>
                    <TextBlock Text="Publish Event to SequenceContext:" FontWeight="Bold"/>
                    <ComboBox Text="{Binding ControlVM.EventToPublish, Mode=TwoWay}" IsEditable="True" Height="30" Margin="0,4,0,8">
                        <ComboBoxItem Content="EVENT_MANUAL_LOADING"/>
                        <ComboBoxItem Content="EVENT_MANUAL_UNLOADING"/>
                        <ComboBoxItem Content="EVENT_SEQ_LOADINGNODE"/>
                    </ComboBox>
                    <Button Content="Publish Event Now" Style="{StaticResource StRoundedButton}" Background="#A3DA97" Height="34" Margin="0,0,0,8" Click="PublishEvent_Click"/>
                    <CheckBox Content="Require Manual Load Event in LoadingSeq" Click="ToggleManualLoadMode_Click" Margin="0,4"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- 5. WMX3 Motion Test -->
        <GroupBox Header="WMX3 EtherCAT Servo Motion Test &amp; Axis Monitor" Style="{StaticResource StGroupBox22}"
                  Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='WMX3 Motion Test'}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,4,4,10">
                    <TextBlock Text="Selected Axis:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Runtime.Axes}" SelectedItem="{Binding ControlVM.SelectedAxis}" DisplayMemberPath="AxisName" Width="130" Height="32"/>
                    <TextBlock Text="Step (mm):" VerticalAlignment="Center" FontWeight="Bold" Margin="14,0,6,0"/>
                    <TextBox Text="{Binding ControlVM.JogStepMm}" Width="70" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="◀ JOG -" Style="{StaticResource StRoundedButton}" Width="95" Margin="3,0" Click="JogMinus_Click"/>
                    <Button Content="HOME (0)" Style="{StaticResource StRoundedButton}" Width="95" Margin="3,0" Click="JogHome_Click"/>
                    <Button Content="JOG + ▶" Style="{StaticResource StRoundedButton}" Width="95" Margin="3,0" Click="JogPlus_Click"/>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Runtime.Axes}" SelectedItem="{Binding ControlVM.SelectedAxis}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Servo ON" Binding="{Binding ServoOn}" Width="80"/>
                        <DataGridCheckBoxColumn Header="Homed" Binding="{Binding IsHomed}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Axis" Binding="{Binding AxisName}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Motion Group" Binding="{Binding MotionGroup}" Width="190" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Command Pos (mm)" Binding="{Binding CommandPos, StringFormat={}{0:F3}}" Width="140"/>
                        <DataGridTextColumn Header="Actual Pos (mm)" Binding="{Binding ActualPos, StringFormat={}{0:F3}}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Velocity (mm/s)" Binding="{Binding Velocity, StringFormat={}{0:F1}}" Width="130"/>
                        <DataGridTextColumn Header="Torque Load (%)" Binding="{Binding LoadPercent, StringFormat={}{0:F1}%}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- 6. BUSOP -->
        <GroupBox Header="BUSOP Standard Verification (Force / LoadCell / Vision Static &amp; Dynamic T31)" Style="{StaticResource StGroupBox21}"
                  Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='BUSOP'}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,4,4,10">
                    <Button Content="Run All BUSOP Verification Sequences" Style="{StaticResource StRoundedButton}" Background="#8DD471" Width="260" Height="36" Click="RunAllBusop_Click"/>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Runtime.BusopItems}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SOP Category" Binding="{Binding SopGroup}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sequence ID" Binding="{Binding SequenceId}" Width="240" IsReadOnly="True"/>
                        <DataGridTextColumn Header="LSL" Binding="{Binding Lsl, StringFormat={}{0:F3}}" Width="100"/>
                        <DataGridTextColumn Header="USL" Binding="{Binding Usl, StringFormat={}{0:F3}}" Width="100"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Measured" Binding="{Binding Measured, StringFormat={}{0:F4}}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Judgment" Binding="{Binding Judge}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
