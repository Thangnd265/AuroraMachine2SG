<UserControl x:Class="AuroraMachine2SG.App.Views.SettingViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" FontSize="12">
    <Grid Margin="12">
        <!-- 1. EquipSetting -->
        <Grid Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='EquipSetting'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Equipment Configuration (Equipment.json)" Style="{StaticResource StGroupBox21}">
                <StackPanel Margin="12">
                    <TextBlock Text="Equipment Name" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Runtime.Equipment.EquipmentName}" Padding="5" Margin="0,3,0,8"/>
                    <TextBlock Text="Manufacturing Site (FXCN / TEMD / THER / FXBL / FXGL)" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Runtime.Equipment.SiteList}" SelectedItem="{Binding Runtime.Equipment.Site}" Height="30" Margin="0,3,0,8"/>
                    <TextBlock Text="Line No / Machine No" FontWeight="SemiBold"/>
                    <UniformGrid Columns="2" Margin="0,3,0,8">
                        <TextBox Text="{Binding Runtime.Equipment.LineNo}" Padding="5" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding Runtime.Equipment.MachineNo}" Padding="5" Margin="4,0,0,0"/>
                    </UniformGrid>
                    <CheckBox Content="Simulation Mode Enabled" IsChecked="{Binding Runtime.Equipment.SimulationMode}" Margin="0,4"/>
                    <CheckBox Content="Use Screen Lock on Startup" IsChecked="{Binding Runtime.Equipment.UseScreenLock}" Margin="0,4"/>
                    <Button Content="Save Equipment &amp; HIVE Settings" Style="{StaticResource StRoundedButton}" Background="#8DD471" Width="230" Height="36" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveEquip_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="HIVE 3.x Server &amp; Dual Emulator Logging (v2.6.6.1)" Style="{StaticResource StGroupBox22}">
                <StackPanel Margin="12">
                    <TextBlock Text="Machine Serial Number (MachineSN)" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Runtime.HiveCfg.MachineSn}" Padding="5" Margin="0,3,0,8"/>
                    <TextBlock Text="Production HIVE Server IP : Port" FontWeight="SemiBold"/>
                    <UniformGrid Columns="2" Margin="0,3,0,8">
                        <TextBox Text="{Binding Runtime.HiveCfg.ServerIp}" Padding="5" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding Runtime.HiveCfg.ServerPort}" Padding="5" Margin="4,0,0,0"/>
                    </UniformGrid>
                    <TextBlock Text="Foxconn HIVE Emulator IP : Port" FontWeight="SemiBold"/>
                    <UniformGrid Columns="2" Margin="0,3,0,8">
                        <TextBox Text="{Binding Runtime.HiveCfg.EmulatorIp}" Padding="5" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding Runtime.HiveCfg.EmulatorPort}" Padding="5" Margin="4,0,0,0"/>
                    </UniformGrid>
                    <CheckBox Content="Enable Simultaneous HIVE Server + Emulator Dual Logging" IsChecked="{Binding Runtime.HiveCfg.UseDualEmulatorLogging}" FontWeight="Bold" Margin="0,6"/>
                    <TextBlock Text="Repair SOP PowerPoint Path" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding Runtime.HiveCfg.SopFilePath}" Padding="5" Margin="0,3,0,8"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- 2. SpareParts (Exact UCSparePartsMonitorView header + grid) -->
        <Grid Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='SpareParts'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Aurora.Brushes.Header.Background}" CornerRadius="4" Padding="12,0">
                <DockPanel>
                    <TextBlock Text="{Binding Runtime.Loc[SpareParts]}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="String Generator" Style="{StaticResource StRoundedButton}" Margin="0,0,10,0" Click="GenStrings_Click"/>
                        <TextBlock Text="Version:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding SettingVM.SparePartsVersion}" Width="90" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="+ Add" Style="{StaticResource StRoundedButton}" Width="70" Margin="3,0" Click="AddPart_Click"/>
                        <Button Content="Reset Selected Count" Style="{StaticResource StRoundedButton}" Width="150" Margin="3,0" Click="ResetPart_Click"/>
                        <Button Content="Save" Style="{StaticResource StRoundedButton}" Background="#8DD471" Width="80" Margin="6,0,0,0" Click="SaveEquip_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataGrid x:Name="SpareGrid" Grid.Row="1" ItemsSource="{Binding Runtime.SpareParts}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="120"/>
                    <DataGridTextColumn Header="Name (EN;ZH)" Binding="{Binding Name}" Width="190"/>
                    <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="130"/>
                    <DataGridCheckBoxColumn Header="Use Alarm" Binding="{Binding IsUseAlarm}" Width="85"/>
                    <DataGridTextColumn Header="Alarm Code" Binding="{Binding AlarmCode}" Width="100"/>
                    <DataGridTextColumn Header="Current Count" Binding="{Binding CurrentCount}" Width="120"/>
                    <DataGridTextColumn Header="Warning Limit" Binding="{Binding WarningLimit}" Width="120"/>
                    <DataGridTextColumn Header="Max Limit" Binding="{Binding MaxLimit}" Width="110"/>
                    <DataGridCheckBoxColumn Header="Alarmed" Binding="{Binding IsAlarmed, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="TxtGeneratedCode" Grid.Row="2" Height="95" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                     Background="#1E293B" Foreground="#E2E8F0" Padding="8" VerticalScrollBarVisibility="Auto"
                     Text="// Click 'String Generator' to generate C# SparePartNames constants"/>
        </Grid>

        <!-- 3. LogSetting (Up to 20 Log Configs per v2.6.5.1) -->
        <GroupBox Header="HisLogger Configuration Manager (Max 20 Configs per v2.6.5.1)" Style="{StaticResource StGroupBox22}"
                  Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='LogSetting'}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="+ Add Logger Config (Max 20)" Style="{StaticResource StRoundedButton}" Width="210" Click="AddLogger_Click"/>
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Runtime.LogConfigs}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Slot #" Binding="{Binding SlotNo}" Width="70" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/>
                        <DataGridTextColumn Header="Logger Name" Binding="{Binding LoggerName}" Width="220"/>
                        <DataGridTextColumn Header="Log Level" Binding="{Binding Level}" Width="120"/>
                        <DataGridTextColumn Header="Retention (Days)" Binding="{Binding RetentionDays}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- 4. BackUp -->
        <GroupBox Header="AutoBackupView2 — Configuration &amp; Recipe Snapshot Archive" Style="{StaticResource StGroupBox21}"
                  Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='BackUp'}">
            <StackPanel Margin="16">
                <TextBlock Text="Archives _config_setting/, _config_recipe/, and _alarm/ into a timestamped ZIP in _data/_backup/." FontSize="13" Margin="0,0,0,12"/>
                <Button Content="Create Full Configuration Backup ZIP Now" Style="{StaticResource StRoundedButton}" Background="#8DD471" Width="290" Height="40" HorizontalAlignment="Left" Click="BackupNow_Click"/>
                <TextBlock Text="{Binding SettingVM.LastBackupStatus}" FontSize="14" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,14,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 5. Shortcut -->
        <GroupBox Header="Global Keyboard Shortcuts &amp; ScreenShotSequence" Style="{StaticResource StGroupBox22}"
                  Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Shortcut'}">
            <StackPanel Margin="16">
                <TextBlock Text="• Ctrl + P  — Capture full Aurora HMI window PNG screenshot into _data/_export/" FontSize="14" FontWeight="Bold" Margin="0,4"/>
                <TextBlock Text="• Top Lock Icon  — Engage safety ScreenLock interlock overlay" FontSize="14" Margin="0,4"/>
                <TextBlock Text="• Bottom HIVE Station Pills  — Open HIVE 3.x Manual DT / Maintenance / Report End" FontSize="14" Margin="0,4"/>
                <Button Content="Capture Window Screenshot Now (Ctrl+P)" Style="{StaticResource StRoundedButton}" Background="#E0E7FF" Width="280" Height="40" HorizontalAlignment="Left" Margin="0,16,0,0" Click="CaptureNow_Click"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
