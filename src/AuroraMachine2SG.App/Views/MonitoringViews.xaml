<UserControl x:Class="AuroraMachine2SG.App.Views.MonitoringViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuroraMachine2SG.App.Controls"
             Background="#F8FAFC" FontSize="12">
    <Grid Margin="10">
        <!-- 1. WMX3 IO -->
        <GroupBox Header="WMX3 Digital I/O Live Matrix (16 Inputs / 16 Outputs)" Style="{StaticResource StGroupBox22}"
                  Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='WMX3 IO'}">
            <ItemsControl ItemsSource="{Binding Runtime.IoBits}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Background="White" Margin="4" Padding="8,6">
                            <DockPanel>
                                <Ellipse Width="14" Height="14" Fill="{Binding State, Converter={StaticResource ConvActivePillBrush}}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Address, StringFormat=[{0:000}]}" FontWeight="Bold" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding State, Mode=TwoWay}" IsEnabled="{Binding IsOutput}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <!-- 2. FATP Cpk (Exact UCFATPCpk layout) -->
        <Grid Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='FATP Cpk'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Header Bar -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Aurora.Brushes.Header.Background}" CornerRadius="4" Padding="12,0">
                <DockPanel>
                    <TextBlock Text="FATP Cpk" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <DatePicker SelectedDate="{Binding MonitoringVM.StartDay}" Width="120" Margin="4,0"/>
                        <ComboBox ItemsSource="{Binding MonitoringVM.HourItems}" SelectedItem="{Binding MonitoringVM.FromHour}" Width="52"/>
                        <TextBlock Text="H  ~  " VerticalAlignment="Center" FontWeight="Bold"/>
                        <DatePicker SelectedDate="{Binding MonitoringVM.EndDay}" Width="120" Margin="4,0"/>
                        <ComboBox ItemsSource="{Binding MonitoringVM.HourItems}" SelectedItem="{Binding MonitoringVM.ToHour}" Width="52"/>
                        <TextBlock Text="H" VerticalAlignment="Center" Margin="3,0,10,0"/>
                        <Button Content="{Binding Runtime.Loc[Today]}" Style="{StaticResource StRoundedButton}" Width="75" Margin="3,0" Click="CpkToday_Click"/>
                        <Button Content="{Binding Runtime.Loc[All]}" Style="{StaticResource StRoundedButton}" Width="75" Margin="3,0" Click="CpkAll_Click"/>
                        <Button Content="{Binding Runtime.Loc[ExportCSV]}" Style="{StaticResource StRoundedButton}" Background="#E0E7FF" Width="115" Margin="8,0,0,0" Click="CpkExport_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Left Item Checklist + Apply Selected Items -->
            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,8,8,0" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="{Binding Runtime.Loc[ApplySelectedItems]}"
                            Style="{StaticResource StRoundedButton}" Background="#8DD471" Height="38" Margin="0,8,0,0" Click="CpkApply_Click"/>
                    <ItemsControl ItemsSource="{Binding Runtime.PdcaItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsShown, Mode=TwoWay}" Margin="4,6" FontWeight="SemiBold">
                                    <TextBlock Text="{Binding Name}"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Right CPK Charts UniformGrid -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="0,8,0,6" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding MonitoringVM.ShownCpkCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <GroupBox Header="{Binding Item.Name}" Style="{StaticResource StGroupBox21}" Height="215">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding SummaryLine}" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A" Margin="2,0,2,4"/>
                                    <controls:CpkChartView Grid.Row="1" Item="{Binding Item}"/>
                                </Grid>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom Black Badges (Start / End / Cycles / UPH) -->
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Background="#111827" CornerRadius="4" Padding="10,5" Margin="4,0">
                    <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding MonitoringVM.StartDay, StringFormat=Start : {0:yyyy-MM-dd}}"/>
                </Border>
                <Border Background="#111827" CornerRadius="4" Padding="10,5" Margin="4,0">
                    <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding MonitoringVM.EndDay, StringFormat=End : {0:yyyy-MM-dd}}"/>
                </Border>
                <Border Background="#111827" CornerRadius="4" Padding="10,5" Margin="4,0">
                    <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding Runtime.Upd, StringFormat=Cycles : {0}}"/>
                </Border>
                <Border Background="#111827" CornerRadius="4" Padding="10,5" Margin="4,0">
                    <TextBlock Foreground="White" FontWeight="Bold" Text="{Binding Runtime.Uph, StringFormat=UPH : {0}}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 3. PDCADataMonitoring -->
        <GroupBox Header="PDCA Inspection Parameter Stream (BALI / PDCA Collector)" Style="{StaticResource StGroupBox22}"
                  Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='PDCADataMonitoring'}">
            <DataGrid ItemsSource="{Binding MonitoringVM.ShownCpkCards}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Parameter Name" Binding="{Binding Item.Name}" Width="210"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Item.Unit}" Width="75"/>
                    <DataGridTextColumn Header="LSL" Binding="{Binding Item.LSL, StringFormat={}{0:F4}}" Width="100"/>
                    <DataGridTextColumn Header="USL" Binding="{Binding Item.USL, StringFormat={}{0:F4}}" Width="100"/>
                    <DataGridTextColumn Header="Samples (N)" Binding="{Binding Spc.N}" Width="95"/>
                    <DataGridTextColumn Header="Mean" Binding="{Binding Spc.Mean, StringFormat={}{0:F4}}" Width="110"/>
                    <DataGridTextColumn Header="StdDev" Binding="{Binding Spc.StdDev, StringFormat={}{0:F4}}" Width="110"/>
                    <DataGridTextColumn Header="Cp" Binding="{Binding Spc.Cp, StringFormat={}{0:F2}}" Width="90"/>
                    <DataGridTextColumn Header="Cpk" Binding="{Binding Spc.Cpk, StringFormat={}{0:F2}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 4. PerformanceMetrics (Exact UCPerformanceMetricsView header + OEE station cards) -->
        <Grid Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='PerformanceMetrics'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Aurora.Brushes.Header.Background}" CornerRadius="4" Padding="12,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Runtime.Loc[PerformanceMetrics]}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <DatePicker SelectedDate="{Binding MonitoringVM.SelectedMetricsDate}" Width="145"/>
                    </StackPanel>
                    <Button Content="{Binding Runtime.Loc[ExportCSV]}" Style="{StaticResource StRoundedButton}" Width="125" HorizontalAlignment="Right" VerticalAlignment="Center" Click="PerfExport_Click"/>
                </DockPanel>
            </Border>
            <TabControl Grid.Row="1" Margin="0,8,0,0">
                <TabItem Header="Station 0 : HSGProcess">
                    <UniformGrid Columns="4" Margin="10" VerticalAlignment="Top" Height="150">
                        <GroupBox Header="OEE (%)" Style="{StaticResource StGroupBox21}">
                            <TextBlock Text="{Binding MonitoringVM.OeePct, StringFormat={}{0:F2}%}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </GroupBox>
                        <GroupBox Header="Availability (%)" Style="{StaticResource StGroupBox24}">
                            <TextBlock Text="{Binding MonitoringVM.AvailabilityPct, StringFormat={}{0:F2}%}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </GroupBox>
                        <GroupBox Header="Performance (%)" Style="{StaticResource StGroupBox22}">
                            <TextBlock Text="{Binding MonitoringVM.PerformancePct, StringFormat={}{0:F2}%}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </GroupBox>
                        <GroupBox Header="Quality Yield (%)" Style="{StaticResource StGroupBox23}">
                            <TextBlock Text="{Binding MonitoringVM.QualityPct, StringFormat={}{0:F2}%}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </GroupBox>
                    </UniformGrid>
                </TabItem>
                <TabItem Header="Station 1 : MPSProcess">
                    <TextBlock Text="MPSProcess Sub-Station OEE: 91.61% (Availability 97.10% | Performance 95.20% | Quality 99.10%)" FontSize="15" FontWeight="Bold" Margin="20"/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 5. LoadFactor -->
        <GroupBox Header="Servo Motor Torque Load Factor Telemetry (MotorLoadDB)" Style="{StaticResource StGroupBox21}"
                  Visibility="{Binding ActiveSubMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='LoadFactor'}">
            <ItemsControl ItemsSource="{Binding Runtime.Axes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding AxisName}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding MotionGroup}" Foreground="#475569"/>
                            <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding LoadPercent}" Height="18" Margin="8,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding LoadPercent, StringFormat={}{0:F1}%}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>
    </Grid>
</UserControl>
