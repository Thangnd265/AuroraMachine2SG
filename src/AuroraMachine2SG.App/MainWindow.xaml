<Window x:Class="AuroraMachine2SG.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AuroraMachine2SG.App.Controls"
        xmlns:views="clr-namespace:AuroraMachine2SG.App.Views"
        Title="Aurora 2.6.7.6 — Extensible Simulation &amp; Machine Development Platform"
        Width="1720" Height="980" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#FBFBFB"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. TOP AURORA TITLE + HIVE INDICATOR + PROFILE SWITCHER BAR (#102236) -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Aurora.Brushes.Title.Background}" Padding="10,6">
            <DockPanel>
                <!-- Brand + Equipment ID -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Background="{StaticResource BLGRed}" CornerRadius="5" Width="40" Height="40" Margin="0,0,8,0">
                        <TextBlock Text="SG" Foreground="White" FontWeight="ExtraBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AURORA DEV PLATFORM 2.6.7.6" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Runtime.Equipment.EquipmentName}" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <!-- UCHiveIndicator (Play / Pause / Stop) + OpenFolder + JOG + UCMaintCounter with QR -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Width="52" Height="52" Margin="2,0" Style="{StaticResource StToggleStatus}"
                                  Background="{StaticResource BHiveGreen}" ToolTip="{Binding Runtime.Loc[Play]}"
                                  IsChecked="{Binding Runtime.IsSequenceRunning, Mode=OneWay}" Click="Play_Click">
                        <Path Data="{StaticResource GeoPlay}" Fill="#0F172A" Stretch="Uniform" Width="20" Height="20"/>
                    </ToggleButton>
                    <ToggleButton Width="52" Height="52" Margin="2,0" Style="{StaticResource StToggleStatus}"
                                  Background="{StaticResource BHiveBlue}" ToolTip="{Binding Runtime.Loc[Pause]}"
                                  IsChecked="{Binding Runtime.IsSequencePaused, Mode=OneWay}" Click="Pause_Click">
                        <Path Data="{StaticResource GeoPause}" Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                    </ToggleButton>
                    <ToggleButton Width="52" Height="52" Margin="2,0" Style="{StaticResource StToggleStatus}"
                                  Background="{StaticResource BHiveRed}" ToolTip="{Binding Runtime.Loc[Stop]}"
                                  IsChecked="{Binding Runtime.IsSequenceIdle, Mode=OneWay}" Click="Stop_Click">
                        <Path Data="{StaticResource GeoStop}" Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                    </ToggleButton>

                    <Button Width="50" Height="52" Margin="10,0,3,0" Style="{StaticResource StRoundedButton}" ToolTip="Open _data Folder" Click="OpenFolder_Click">
                        <Path Data="{StaticResource GeoFolder}" Fill="#1E293B" Stretch="Uniform" Width="22" Height="22"/>
                    </Button>
                    <Button Width="54" Height="52" Margin="2,0" Style="{StaticResource StRoundedButton}" Content="JOG" FontSize="14" FontWeight="ExtraBold"
                            IsEnabled="{Binding Runtime.IsSequenceRunning, Converter={StaticResource ConvInverseBool}}" Click="Jog_Click"/>

                    <!-- UCMaintCounter + QR Code -->
                    <Border Background="{StaticResource BSGLightGray}" CornerRadius="5" Padding="7,3" Margin="8,0,0,0" Height="54"
                            Cursor="Hand" MouseLeftButtonUp="HivePill_Click" ToolTip="Click to open HIVE 3.x Downtime / Maintenance / QR">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock FontSize="11">
                                    <Run Text="{Binding Runtime.Loc[Weekly], Mode=OneWay}"/> :
                                    <Run Text="{Binding Runtime.HiveCfg.WeeklyMaintRemainDays}" FontWeight="Bold" Foreground="#1E3A8A"/> D
                                </TextBlock>
                                <TextBlock FontSize="11" Margin="0,2,0,0">
                                    <Run Text="{Binding Runtime.Loc[Monthly], Mode=OneWay}"/> :
                                    <Run Text="{Binding Runtime.HiveCfg.MonthlyMaintRemainDays}" FontWeight="Bold" Foreground="#1E3A8A"/> D
                                </TextBlock>
                            </StackPanel>
                            <controls:QrCodeView Width="46" Height="46" Payload="{Binding Runtime.Hive.ActiveQrPayload}"/>
                        </StackPanel>
                    </Border>

                    <!-- Machine Profile Switcher + Load External Plugin .dll -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <ComboBox ItemsSource="{Binding Runtime.AvailableProfiles}" SelectedItem="{Binding Runtime.ActiveProfile, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayTitle" Width="245" Height="34" VerticalContentAlignment="Center"
                                  SelectionChanged="ProfileCombo_Changed" ToolTip="Switch Equipment Profile (IEquipmentSetup)"/>
                        <Button Content="+ .DLL" Style="{StaticResource StRoundedButton}" Background="#FEF08A" Height="34" Padding="8,4" Margin="4,0,0,0"
                                ToolTip="Load Custom IEquipmentSetup Plugin .dll" Click="LoadPluginDll_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Cluster: Top-Bar Device Status + DevTrace Toggle + Language + ScreenLock + Badge Login -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Runtime.Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="5,3" Margin="2,0"
                                        Background="{Binding IsActivated, Converter={StaticResource ConvActivePillBrush}}"
                                        Visibility="{Binding ShowInTopBar, Converter={StaticResource ConvBoolToVis}}">
                                    <TextBlock Text="{Binding DeviceId}" FontSize="10" FontWeight="Bold" Foreground="#0F172A"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ToggleButton Content="Dev Trace" Style="{StaticResource StToggle1}" Height="32" Margin="6,0,4,0" Padding="8,2"
                                  IsChecked="{Binding ShowDevTraceDock, Mode=TwoWay}" ToolTip="Show/Hide Live Sequence &amp; HisLogger Trace Dock"/>

                    <ComboBox x:Name="LangCombo" Width="80" Height="32" Margin="4,0" VerticalContentAlignment="Center"
                              SelectionChanged="LangCombo_SelectionChanged"/>

                    <Button Width="36" Height="34" Margin="2,0" Style="{StaticResource StRoundedButton}" ToolTip="Lock Screen" Click="LockScreen_Click">
                        <Path Data="{StaticResource GeoLock}" Fill="#1E293B" Stretch="Uniform" Width="15" Height="15"/>
                    </Button>

                    <Button Height="34" Padding="8,4" Margin="4,0,0,0" Style="{StaticResource StRoundedButton}" Background="#E0E7FF" Click="LoginBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoBadge}" Fill="#1E3A8A" Stretch="Uniform" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5">
                                <Run Text="{Binding Runtime.Hive.LoggedInBadgeName, Mode=OneWay}"/>
                                <Run Text=" ("/><Run Text="{Binding Runtime.Hive.CurrentPermission, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. LEFT NAVIGATION RAIL (6 Main Menus) -->
        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Background="{StaticResource BNavy}">
            <StackPanel Margin="0,6,0,0">
                <RadioButton x:Name="NavMain" GroupName="MainNav" IsChecked="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqBool}, ConverterParameter='Main', Mode=OneWay}" Style="{StaticResource StLeftMenuButton}" Tag="Main" Click="MainNav_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoHome}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Runtime.Loc[Main]}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavControl" GroupName="MainNav" IsChecked="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqBool}, ConverterParameter='Control', Mode=OneWay}" Style="{StaticResource StLeftMenuButton}" Tag="Control" Click="MainNav_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoControl}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Runtime.Loc[Control]}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavRecipe" GroupName="MainNav" IsChecked="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqBool}, ConverterParameter='Recipe', Mode=OneWay}" Style="{StaticResource StLeftMenuButton}" Tag="Recipe" Click="MainNav_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoRecipe}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Runtime.Loc[Recipe]}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAlarm" GroupName="MainNav" IsChecked="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqBool}, ConverterParameter='Alarm', Mode=OneWay}" Style="{StaticResource StLeftMenuButton}" Tag="Alarm" Click="MainNav_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoAlarm}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Runtime.Loc[Alarm]}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavMonitoring" GroupName="MainNav" IsChecked="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqBool}, ConverterParameter='Monitoring', Mode=OneWay}" Style="{StaticResource StLeftMenuButton}" Tag="Monitoring" Click="MainNav_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoMonitor}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Runtime.Loc[Monitoring]}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSetting" GroupName="MainNav" IsChecked="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqBool}, ConverterParameter='Setting', Mode=OneWay}" Style="{StaticResource StLeftMenuButton}" Tag="Setting" Click="MainNav_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource GeoSetting}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Runtime.Loc[Setting]}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 3. SUBMENU BAR -->
        <Border Grid.Row="1" Grid.Column="1" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="10,5"
                Visibility="{Binding ShowSubMenuBar, Converter={StaticResource ConvBoolToVis}}">
            <ItemsControl ItemsSource="{Binding CurrentSubMenus}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Style="{StaticResource StRoundedButton}" Margin="0,0,6,0" Padding="14,5"
                                Tag="{Binding}" Click="SubMenu_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 4. MAIN CONTENT AREA -->
        <Grid Grid.Row="2" Grid.Column="1">
            <views:HomeView x:Name="HomeViewHost" Visibility="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Main'}"/>
            <views:ControlViews Visibility="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Control'}"/>
            <views:RecipeViews Visibility="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Recipe'}"/>
            <views:AlarmViews Visibility="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Alarm'}"/>
            <views:MonitoringViews Visibility="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Monitoring'}"/>
            <views:SettingViews Visibility="{Binding ActiveMainMenu, Converter={StaticResource ConvStrEqVis}, ConverterParameter='Setting'}"/>
        </Grid>

        <!-- 5. COLLAPSIBLE LIVE DEV TRACE DOCK (Overview of What All Sequences & Logs Are Doing Right Now!) -->
        <Border Grid.Row="3" Grid.Column="1" Height="138" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,2,0,0" Padding="8,5"
                Visibility="{Binding ShowDevTraceDock, Converter={StaticResource ConvBoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Real-time Active Node per Sequence -->
                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="LIVE SEQUENCE MONITOR" Foreground="#38BDF8" FontWeight="ExtraBold" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="⏭ Step All 1x" Padding="6,1" Margin="10,0,0,0" FontSize="10.5" FontWeight="Bold" Click="StepAllOnce_Click"/>
                        <Button Content="Open Flowchart" Padding="6,1" Margin="6,0,0,0" FontSize="10.5" Click="JumpToFlowchart_Click"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Runtime.ActiveSequences}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,5,4">
                                    <TextBlock FontSize="10.5" FontFamily="Consolas">
                                        <Run Text="{Binding SequenceId, Mode=OneWay}" Foreground="#93C5FD" FontWeight="Bold"/>
                                        <Run Text=" → " Foreground="#94A3B8"/>
                                        <Run Text="{Binding CurrentNodeId, Mode=OneWay}" Foreground="#86EFAC" FontWeight="Bold"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- Right: Live HisLogger Stream -->
                <DockPanel Grid.Column="1">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="HISLOGGER LIVE TRACE (Sequences / Devices / HIVE / Events)" Foreground="#FDE047" FontWeight="ExtraBold" FontSize="11" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Clear Log" Padding="8,1" FontSize="10.5" HorizontalAlignment="Right" Click="ClearLog_Click"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Runtime.LoggerHub.Entries}" Background="#020617" BorderBrush="#1E293B" BorderThickness="1"
                             Foreground="#E2E8F0" FontFamily="Consolas" FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Formatted}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 6. BOTTOM STATUS BAR (Dynamic Station Pills per Profile + VKeyboard Toggle) -->
        <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#EAEAEB" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusBanner}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ItemsControl ItemsSource="{Binding Runtime.StationBadgeNames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="9,2" Margin="2,0" Cursor="Hand" BorderThickness="0"
                                        Background="{Binding DataContext.Runtime.Hive.CurrentState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ConvHiveBrush}}"
                                        Click="HivePill_Click">
                                    <TextBlock FontWeight="Bold" FontSize="11">
                                        <Run Text="{Binding Mode=OneWay}"/><Run Text=" : "/>
                                        <Run Text="{Binding DataContext.Runtime.Hive.StateDisplayText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ToggleButton Content="V-Keyboard : ON/OFF" Style="{StaticResource StToggle1}" Margin="8,0,8,0" Padding="8,2"
                                  IsChecked="{Binding Runtime.Equipment.UseVirtualKeyboard, Mode=TwoWay}"/>
                    <TextBlock x:Name="ClockText" VerticalAlignment="Center" FontWeight="Bold" Width="135" TextAlignment="Right"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 7. SAFETY SCREEN LOCK OVERLAY -->
        <Grid Grid.RowSpan="5" Grid.ColumnSpan="2" Background="#CC0F172A"
              Visibility="{Binding IsScreenLocked, Converter={StaticResource ConvBoolToVis}}">
            <Border Background="White" CornerRadius="10" Width="420" Height="230" Padding="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="SCREEN INTERLOCK ENGAGED" FontSize="17" FontWeight="ExtraBold" Foreground="#A50034" HorizontalAlignment="Center"/>
                    <TextBlock Text="Touch &amp; keyboard operations are locked to prevent unintended motion." TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,20" Foreground="#334155"/>
                    <Button Content="Unlock Operator Screen" Style="{StaticResource StRoundedButton}" Background="#8DD471" Width="210" Height="42" Click="UnlockScreen_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
